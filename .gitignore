# Out-of-source CMake build directories: build/ = SCALAR backend (regression
# testing), build-avx2/ = AVX2 backend (produces the shipped extension),
# build-examples/ and build-bench/ = AVX2 with other FASTMLP_BUILD_* options,
# so rebuilding them never touches the shipped .so.
/build/
/build-avx2/
/build-examples/
/build-bench/

# Built Python extension, produced by bindings/python's CMake target straight
# into the package directory.
python/fastmlp/_fastmlp*.so

# Python bytecode / test caches
__pycache__/
*.pyc
.pytest_cache/

# Generated datasets and initial weights
examples/two_moons/data/
examples/mnist/data/
examples/tree_regression/data/
examples/deep_mlp/data/
benchmarks/suite/data/
benchmarks/suite/results/quick/

# Markdown: only README.md is tracked. Design notes, per-run result write-ups
# and the generated suite report stay local.
*.md
!README.md

# Claude Code local settings
.claude/settings.local.json
